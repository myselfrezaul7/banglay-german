rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Match any document in the 'users' collection
    match /users/{userId} {
      
      // Anyone can read user documents (required for public Leaderboard)
      allow read: if true;
      
      // A user can only write to their own document if authenticated
      // and incoming data respects proper attribute types and non-negative bounds
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && (!('xp' in request.resource.data) || (request.resource.data.xp is number && request.resource.data.xp >= 0))
                   && (!('level' in request.resource.data) || (request.resource.data.level is number && request.resource.data.level >= 1))
                   && (!('streak' in request.resource.data) || (request.resource.data.streak is number && request.resource.data.streak >= 0))
                   && (!('achievements' in request.resource.data) || request.resource.data.achievements is list)
                   && (!('learnedWords' in request.resource.data) || request.resource.data.learnedWords is list)
                   && (!('favorites' in request.resource.data) || request.resource.data.favorites is list);
    }
  }
}

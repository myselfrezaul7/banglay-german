rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Match any document in the 'users' collection
    match /users/{userId} {
      
      // Anyone can read user documents (required for public Leaderboard)
      allow read: if true;
      
      // A user can only write to their own document if authenticated
      // and incoming data respects proper attribute types
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && (!('xp' in request.resource.data) || request.resource.data.xp is number)
                   && (!('level' in request.resource.data) || request.resource.data.level is number)
                   && (!('streak' in request.resource.data) || request.resource.data.streak is number);
    }
  }
}
